#!/usr/bin/env bash
# Stub adb for tools/test_device_acceptance.sh. Every call is appended to
# $STUB_ADB_LOG; per-run counters live next to it.
#
# - `adb devices` prints $STUB_ADB_DEVICES.
# - `logcat -d ... godot:V` prints $STUB_GODOT_EARLY_LOG for the first
#   $STUB_GODOT_EARLY_POLLS polls (a suite still running), then $STUB_GODOT_LOG.
#   Any other `logcat -d`, and the streamed `logcat -v threadtime`, print
#   $STUB_GODOT_LOG, the stream after a "stub stream" line.
# - `install` follows $STUB_ADB_INSTALL_SEQUENCE, a space-separated list, one
#   entry per attempt (the last repeats): `ok`, `blank` (fails with no reason,
#   as in #210), `notfound` (the headset dropped off, as in #589) or `full`
#   (fails with a reason: no space left).
# - `wait-for-device` returns at once, or never when $STUB_ADB_WAIT is `hang`.
# - $STUB_ADB_LOCKED: `asleep` or `keyguard` makes dumpsys say so.
# - $STUB_ADB_BACKGROUND=1: the game's activity is never the resumed one.
# - `pidof` succeeds unless $STUB_ADB_DEAD is 1.
# - `cmd package resolve-activity` follows $STUB_ADB_RESOLVE_SEQUENCE like
#   installs: `ok` prints $STUB_ADB_RESOLVE_ACTIVITY (the launcher by default),
#   `empty` prints no activity line (as right after an install, #1392).
# - `am start` refuses $STUB_ADB_NOT_EXPORTED (an activity class) as not exported.
# - $STUB_ADB_DROP_AT=N: the Nth `godot:V` poll finds the headset gone (#1436).
#   While gone, every `-s` call fails as `not found` and `adb devices` lists
#   nothing, for $STUB_ADB_DROP_FOR calls of `devices` (or for ever: `never`).
# - `getprop ro.serialno` prints the serial's entry in $STUB_ADB_HARDWARE
#   ("serial=id ..."), else the serial itself.
# - `run-as <package> ls` lists $STUB_GAME_FILES (the game's storage) oldest
#   first, and `exec-out run-as <package> cat files/acceptance/<name>` prints
#   one of them; with no such folder `ls` fails as on a fresh install.
# - `shell pm path` and `shell sha256sum` report the installed build from
#   $STUB_ADB_INSTALLED_SHA (see installed_sha); $STUB_ADB_PM is `fail` or
#   `nosum` to make the check fail (#1437).
set -euo pipefail
echo "$*" >> "$STUB_ADB_LOG"
state="$(dirname "$STUB_ADB_LOG")"
serial=""
if [ "${1:-}" = "-s" ]; then
	serial="$2"
	shift 2
fi

# Increments the named counter and prints its new value.
count() {
	local file="$state/stub-$1.count" value=0
	if [ -f "$file" ]; then
		value="$(cat "$file")"
	fi
	value=$((value + 1))
	echo "$value" > "$file"
	echo "$value"
}

# The checksum of the build the stub headset holds (#1437): $STUB_ADB_INSTALLED_SHA
# is one checksum for every headset, or "serial=checksum ..." entries. Empty:
# the package is not installed.
installed_sha() {
	local entry
	if [[ "${STUB_ADB_INSTALLED_SHA:-}" != *=* ]]; then
		echo "${STUB_ADB_INSTALLED_SHA:-}"
		return
	fi
	for entry in $STUB_ADB_INSTALLED_SHA; do
		if [ "${entry%%=*}" = "$serial" ]; then
			echo "${entry#*=}"
			return
		fi
	done
}

gone="$state/stub-gone"
if [ -n "$serial" ] && [ -f "$gone" ]; then
	echo "adb: device '$serial' not found" >&2
	exit 1
fi

case "${1:-}" in
	devices)
		echo "List of devices attached"
		if [ -f "$gone" ]; then
			if [ "${STUB_ADB_DROP_FOR:-never}" = "never" ] \
				|| [ "$(count gone-devices)" -le "$STUB_ADB_DROP_FOR" ]; then
				exit 0
			fi
			rm -f "$gone"
		fi
		printf '%b' "${STUB_ADB_DEVICES:-}"
		echo
		;;
	wait-for-device)
		if [ "${STUB_ADB_WAIT:-}" = "hang" ]; then
			exec sleep 600
		fi
		;;
	install)
		read -r -a steps <<< "${STUB_ADB_INSTALL_SEQUENCE:-ok}"
		attempt="$(count install)"
		index=$((attempt - 1))
		if [ "$index" -ge "${#steps[@]}" ]; then
			index=$((${#steps[@]} - 1))
		fi
		case "${steps[$index]}" in
			blank)
				echo "Performing Streamed Install"
				echo "adb: failed to install meltdown-quest-debug.apk:" >&2
				exit 1
				;;
			notfound)
				echo "adb: error: failed to get feature set: device '$serial' not found" >&2
				echo "Performing Push Install"
				exit 1
				;;
			full)
				echo "Performing Streamed Install"
				echo "adb: failed to install meltdown-quest-debug.apk: Failure [INSTALL_FAILED_INSUFFICIENT_STORAGE]"
				exit 1
				;;
		esac
		echo "Performing Streamed Install"
		echo "Success"
		;;
	logcat)
		if [[ " $* " == *" godot:V "* ]] && [ -n "${STUB_ADB_DROP_AT:-}" ] \
			&& [ "$(count godot-poll)" -eq "$STUB_ADB_DROP_AT" ]; then
			touch "$gone"
			echo "adb: device '$serial' not found" >&2
			exit 1
		fi
		if [[ " $* " == *" -d "* ]]; then
			if [[ " $* " == *" godot:V "* ]] && [ -n "${STUB_GODOT_EARLY_LOG:-}" ] \
				&& [ "$(count poll)" -le "${STUB_GODOT_EARLY_POLLS:-0}" ]; then
				cat "$STUB_GODOT_EARLY_LOG"
			elif [ -f "${STUB_GODOT_LOG:-}" ]; then
				cat "$STUB_GODOT_LOG"
			fi
		elif [[ " $* " == *" threadtime "* ]]; then
			echo "stub stream"
			if [ -f "${STUB_GODOT_LOG:-}" ]; then
				cat "$STUB_GODOT_LOG"
			fi
		fi
		;;
	exec-out)
		if [ "${2:-}" = "run-as" ] && [ "${4:-}" = "cat" ]; then
			cat "${STUB_GAME_FILES:-/nonexistent}/$(basename "$5")"
			exit $?
		fi
		;;
	pull)
		echo "not a real PNG" > "$3"
		echo "1 file pulled"
		;;
	shell)
		case "${2:-}" in
			pm)
				# `pm path` as on a headset; $STUB_ADB_PM=fail makes it fail outright.
				if [ "${STUB_ADB_PM:-}" = "fail" ]; then
					echo "cmd: Can't find service: package" >&2
					exit 20
				fi
				if [ -z "$(installed_sha)" ]; then
					exit 1
				fi
				echo "package:/data/app/~~stub==/io.github.nolesszz.meltdown-stub==/base.apk"
				;;
			sha256sum)
				# $STUB_ADB_PM=nosum: an OS without sha256sum.
				if [ "${STUB_ADB_PM:-}" = "nosum" ]; then
					echo "/system/bin/sh: sha256sum: not found" >&2
					exit 127
				fi
				echo "$(installed_sha)  ${3:-}"
				;;
			settings)
				if [ "${3:-}" = "get" ]; then
					echo "2"
				fi
				;;
			getprop)
				for entry in ${STUB_ADB_HARDWARE:-}; do
					if [ "${entry%%=*}" = "$serial" ]; then
						echo "${entry#*=}"
						exit 0
					fi
				done
				echo "$serial"
				;;
			run-as)
				if [ "${4:-}" = "ls" ]; then
					if [ ! -d "${STUB_GAME_FILES:-/nonexistent}" ]; then
						echo "ls: files/acceptance: No such file or directory" >&2
						exit 1
					fi
					ls -tr "$STUB_GAME_FILES"
				fi
				;;
			pidof)
				if [ "${STUB_ADB_DEAD:-0}" = "1" ]; then
					exit 1
				fi
				echo "4242"
				;;
			dumpsys)
				case "${3:-}" in
					power)
						if [ "${STUB_ADB_LOCKED:-}" = "asleep" ]; then
							echo "  mWakefulness=Asleep"
						else
							echo "  mWakefulness=Awake"
						fi
						;;
					window)
						if [ "${STUB_ADB_LOCKED:-}" = "keyguard" ]; then
							echo "    isKeyguardShowing=true"
						else
							echo "    isKeyguardShowing=false"
						fi
						;;
					activity)
						if [ "${STUB_ADB_BACKGROUND:-0}" = "1" ]; then
							echo "    mResumedActivity: ActivityRecord{1a2b u0 com.oculus.vrshell/.MainActivity t3}"
						else
							echo "    mResumedActivity: ActivityRecord{1a2b u0 io.github.nolesszz.meltdown/com.godot.game.GodotApp t12}"
						fi
						;;
				esac
				;;
			cmd)
				read -r -a answers <<< "${STUB_ADB_RESOLVE_SEQUENCE:-ok}"
				attempt="$(count resolve)"
				index=$((attempt - 1))
				if [ "$index" -ge "${#answers[@]}" ]; then
					index=$((${#answers[@]} - 1))
				fi
				echo "priority=0 preferredOrder=0 match=0x108000 specificIndex=-1 isDefault=true"
				if [ "${answers[$index]}" = "ok" ]; then
					echo "io.github.nolesszz.meltdown/${STUB_ADB_RESOLVE_ACTIVITY:-com.godot.game.GodotAppLauncher}"
				fi
				;;
			am)
				if [ "${3:-}" = "start" ]; then
					if [ -n "${STUB_ADB_NOT_EXPORTED:-}" ] && [ "${5:-}" = "io.github.nolesszz.meltdown/$STUB_ADB_NOT_EXPORTED" ]; then
						echo "Starting: Intent { cmp=${5} (has extras) }"
						echo "Exception occurred while executing 'start':"
						echo "java.lang.SecurityException: Permission Denial: starting Intent { flg=0x10000000 cmp=${5} (has extras) } from null (pid=4321, uid=2000) not exported from uid 10207"
						exit 255
					fi
					echo "Starting: Intent { cmp=${5:-} (has extras) }"
				fi
				;;
		esac
		;;
	*)
		echo "stub adb: unexpected command '$*'" >&2
		exit 1
		;;
esac
