#!/usr/bin/env bash
# Stub adb for tools/test_update_quest.sh. Every call is appended to
# $STUB_ADB_LOG. `adb devices` prints $STUB_ADB_DEVICES. `install` succeeds,
# unless $STUB_ADB_INCOMPATIBLE is 1 and the serial has not been uninstalled
# yet, in which case it fails with a signature mismatch like a real headset
# (`sticky` keeps failing after the uninstall).
# $STUB_ADB_BLANK makes `install` fail with an empty reason, as seen in #210:
# `always` on every attempt, `streamed` only without --no-streaming.
# $STUB_ADB_SEQUENCE, a space-separated list, scripts `install` attempt by
# attempt (#589): `blank`, `notfound`, `offline` or `ok`; attempts past the
# end of the list repeat its last entry. `wait-for-device` returns at once,
# or never when $STUB_ADB_WAIT is `hang`.
# `shell pm path` and `shell sha256sum` report the installed build from
# $STUB_ADB_INSTALLED_SHA (see installed_sha); $STUB_ADB_PM is `fail` or
# `nosum` to make that check fail (#1437).
set -euo pipefail
echo "$*" >> "$STUB_ADB_LOG"
serial=""
if [ "${1:-}" = "-s" ]; then
	serial="$2"
	shift 2
fi

# The checksum of the build the stub headset holds (#1437): $STUB_ADB_INSTALLED_SHA
# is one checksum for every headset, or "serial=checksum ..." entries. Empty:
# the package is not installed.
installed_sha() {
	local entry
	if [[ "${STUB_ADB_INSTALLED_SHA:-}" != *=* ]]; then
		echo "${STUB_ADB_INSTALLED_SHA:-}"
		return
	fi
	for entry in $STUB_ADB_INSTALLED_SHA; do
		if [ "${entry%%=*}" = "$serial" ]; then
			echo "${entry#*=}"
			return
		fi
	done
}

case "${1:-}" in
	devices)
		echo "List of devices attached"
		printf '%b' "${STUB_ADB_DEVICES:-}"
		echo
		;;
	wait-for-device)
		if [ "${STUB_ADB_WAIT:-}" = "hang" ]; then
			# exec, so the script's timeout stops the sleep itself.
			exec sleep 600
		fi
		;;
	install)
		if [ -n "${STUB_ADB_SEQUENCE:-}" ]; then
			read -r -a steps <<< "$STUB_ADB_SEQUENCE"
			count_file="$STUB_ADB_STATE/$serial.attempts"
			attempt="$(cat "$count_file" 2> /dev/null || echo 0)"
			echo $((attempt + 1)) > "$count_file"
			if [ "$attempt" -ge "${#steps[@]}" ]; then
				attempt=$((${#steps[@]} - 1))
			fi
			case "${steps[$attempt]}" in
				blank)
					echo "Performing Streamed Install"
					echo "adb: failed to install ${*: -1}: " >&2
					exit 1
					;;
				notfound)
					echo "adb: error: failed to get feature set: device '$serial' not found" >&2
					echo "Performing Push Install"
					exit 1
					;;
				offline)
					echo "adb: error: failed to get feature set: device offline" >&2
					echo "Performing Push Install"
					exit 1
					;;
			esac
			echo "Performing Streamed Install"
			echo "Success"
			exit 0
		fi
		streaming=1
		for arg in "$@"; do
			if [ "$arg" = "--no-streaming" ]; then
				streaming=0
			fi
		done
		blank="${STUB_ADB_BLANK:-}"
		if [ "$blank" = "always" ] || { [ "$blank" = "streamed" ] && [ "$streaming" -eq 1 ]; }; then
			echo "Performing Streamed Install"
			echo "adb: failed to install ${*: -1}: " >&2
			exit 1
		fi
		incompatible="${STUB_ADB_INCOMPATIBLE:-0}"
		if [ "$incompatible" = "sticky" ] \
			|| { [ "$incompatible" = "1" ] && [ ! -f "$STUB_ADB_STATE/$serial.uninstalled" ]; }; then
			echo "Performing Streamed Install"
			echo "adb: failed to install meltdown-quest-debug.apk: Failure [INSTALL_FAILED_UPDATE_INCOMPATIBLE: Existing package io.github.nolesszz.meltdown signatures do not match newer version; ignoring!]"
			exit 1
		fi
		echo "Performing Streamed Install"
		echo "Success"
		;;
	uninstall)
		touch "$STUB_ADB_STATE/$serial.uninstalled"
		echo "Success"
		;;
	shell)
		case "${2:-}" in
			pm)
				# `pm path` as on a headset; $STUB_ADB_PM=fail makes it fail outright.
				if [ "${STUB_ADB_PM:-}" = "fail" ]; then
					echo "cmd: Can't find service: package" >&2
					exit 20
				fi
				if [ -z "$(installed_sha)" ]; then
					exit 1
				fi
				echo "package:/data/app/~~stub==/io.github.nolesszz.meltdown-stub==/base.apk"
				;;
			sha256sum)
				# $STUB_ADB_PM=nosum: an OS without sha256sum.
				if [ "${STUB_ADB_PM:-}" = "nosum" ]; then
					echo "/system/bin/sh: sha256sum: not found" >&2
					exit 127
				fi
				echo "$(installed_sha)  ${3:-}"
				;;
		esac
		;;
	*)
		echo "stub adb: unexpected command '$*'" >&2
		exit 1
		;;
esac
